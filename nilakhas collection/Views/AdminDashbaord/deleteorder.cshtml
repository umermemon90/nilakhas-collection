@model nilakhas_collection.Models.neworderformki
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirm Cancel Order</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container py-5">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Cancel Order</h4>
                <p class="text-muted">Are you sure you want to cancel the following order?</p>

                <dl class="row">
                    <dt class="col-sm-3">Order No</dt>
                    <dd class="col-sm-9">@Model.ordernumber</dd>

                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">@Model.customername</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.phonenumber</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@Model.orderstatus</dd>

                    <dt class="col-sm-3">Total</dt>
                    <dd class="col-sm-9">Rs. @Model.total.ToString("N0")</dd>
                </dl>

                <form asp-action="deleteorder" asp-controller="AdminDashbaord" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.orderid" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Cancel Order</button>
                        <a asp-action="viewallorderspage" asp-controller="AdminDashbaord" class="btn btn-secondary">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>

@model mainpageviewclass
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nilakha's Collection - Orders Management</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/ASITS/CSS/viewallorderpageki.css">
</head>
<body>

    <div class="main-container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="page-title mb-1">All Orders</h3>
                <p class="page-subtitle mb-0">Manage and view all customer orders efficiently</p>
            </div>
            <div class="d-flex gap-2">
                <!-- Back to Dashboard -->
                <a asp-action="mainpagedashbaord" asp-controller="AdminDashbaord" class="btn btn-outline-brand">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
                <a asp-action="neworderform" asp-controller="AdminDashbaord" class="btn btn-brand">
                    <i class="bi bi-plus-lg me-1"></i> New Order
                </a>
            </div>
        </div>

        <!-- Filters -->
        <div class="custom-card py-3 mb-4">
            <div class="row align-items-center justify-content-between g-3">
                <div class="col-md-3">
                    <select class="form-select" id="statusFilter">
                        <option value="">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Process">Process</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <!-- Search bar -->
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Search by Order No or Customer Name...">
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders Table Section -->
        <div class="custom-card">
            <div class="table-responsive">
                <table class="table custom-table mb-0">
                    <thead>
                        <tr>
                            <th>Order No</th>
                            <th>Customer Name</th>
                            <th>Phone Number</th>
                            <th>Booking Date</th>
                            <th>Delivery Date</th>
                            <th>Status</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Advance</th>
                            <th>Due</th>
                            <th>Package</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.orderlist != null && Model.orderlist.Any())
                        {
                            foreach (var orders in Model.orderlist)
                            {
                                <tr class="order-row">
                                    <td class="fw-bold">@orders.ordernumber</td>
                                    <td>@orders.customername</td>
                                    <td>@orders.phonenumber</td>
                                    <td>@orders.bookingdate.ToString("dd MMM yyyy")</td>
                                    <td>@orders.diliverydate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @(
                                            orders.orderstatus == "Pending" ? "badge-pending" :
                                            orders.orderstatus == "Process" ? "badge-process" :
                                            orders.orderstatus == "Completed" ? "badge-completed" : "badge-cancelled"

                                        )">
                                            @orders.orderstatus
                                        </span>
                                    </td>
                                    <td>@orders.quantity</td>
                                    <td>Rs. @orders.total.ToString("N0")</td>
                                    <td>Rs. @orders.advanced.ToString("N0")</td>
                                    <td>Rs. @orders.duepayment.ToString("N0")</td>
                                    <td>@orders.stitchingpackage</td>
                                    <td>
                                        <a asp-action="viewdetailsorder" asp-route-id="@orders.orderid"
                                           class="action-icon view-btn text-decoration-none"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="editorderpage" asp-route-id="@orders.orderid"
                                           class="action-icon view-btn text-decoration-none"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                         
                                         <a asp-action="deleteorder" asp-route-id="@orders.orderid"
                                           class="action-icon view-btn text-decoration-none"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>


                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    No orders found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- JavaScript for Live Search (Only Order No & Customer Name) & Filter -->
    
        <script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("searchInput");
        const statusFilter = document.getElementById("statusFilter");
        const orderRows = document.querySelectorAll(".order-row");

        function filterTable() {

            const searchText =
                searchInput.value.toLowerCase().trim();

            const selectedStatus =
                statusFilter.value.toLowerCase();

            orderRows.forEach(row => {

                const rowText =
                    row.innerText.toLowerCase();

                const badge =
                    row.querySelector(".badge");

                const statusText =
                    badge
                        ? badge.innerText.toLowerCase()
                        : "";

                const matchesSearch =
                    rowText.includes(searchText);

                const matchesStatus =
                    selectedStatus === "" ||
                    statusText === selectedStatus;

                row.style.display =
                    matchesSearch && matchesStatus
                        ? ""
                        : "none";
            });
        }

        searchInput.addEventListener(
            "input",
            filterTable
        );

        statusFilter.addEventListener(
            "change",
            filterTable
        );

    });
</script>
    

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
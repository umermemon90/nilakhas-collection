    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model mainpageviewclass
@{
    Layout = "~/Views/Shared/_AdminDashbaord.cshtml";
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Nilakha's Fashion - Order Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="~/ASITS/CSS/mainpagedashbaord.css">
</head>

<body>
<div class="main-content-wrapper" style="margin-block-start:3rem;">
    <div class="container-fluid px-0">

        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon-wrapper"><i class="bi bi-bag"></i></div>
                    <div>
                        <div class="stat-title">Total Orders</div>
                        <div class="stat-value">@Model.totalorders</div>
                        <div class="stat-trend"><i class="bi bi-arrow-up"></i> Live Feed</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon-wrapper"><i class="bi bi-file-earmark-text"></i></div>
                    <div>
                        <div class="stat-title">Total Billing</div>
                        <div class="stat-value">Rs. @Model.totalbilling</div>
                        <div class="stat-trend"><i class="bi bi-arrow-up"></i> Live Feed</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon-wrapper"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <div class="stat-title">Pending Orders</div>
                        <div class="stat-value">@Model.pendingorders</div>
                        <div class="stat-trend"><i class="bi bi-arrow-up"></i> Live Feed</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon-wrapper"><i class="bi bi-credit-card"></i></div>
                    <div>
                        <div class="stat-title">Pending Payments</div>
                        <div class="stat-value">Rs. @Model.pendingbilling</div>
                        <div class="stat-trend"><i class="bi bi-arrow-up"></i> Live Feed</div>
                    </div>
                </div>
            </div>
        </div>

            
        <div class="table-container-card">
            <div class="table-card-header">
                <h5 class="table-card-title">All Orders</h5>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="neworderform" asp-controller="AdminDashbaord" class="btn-brand-add">
                        <i class="bi bi-plus-lg"></i>
                        <span class="d-none d-sm-inline">New Order</span>
                    </a>
                </div>
            </div>

                <div class="table-responsive">
                    <table class="table custom-table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Order ID</th>
                                <th scope="col">Customer Name</th>
                                <th scope="col">ORDER Status</th>
                                <th scope="col">Delivery Date</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.orderlist != null && Model.orderlist.Any())
                            {
                                foreach (var item in Model.orderlist)
                                {
                                    <tr>
                                        <td>@item.ordernumber</td>
                                        <td>@item.customername</td>
                                        <td>
                                            <span class="badge @(item.orderstatus == "Pending" ? "bg-warning text-dark" : item.orderstatus == "Process" ? "bg-info text-dark" : "bg-success")">
                                                @item.orderstatus
                                            </span>
                                        </td>
                                        <td>@Convert.ToDateTime(item.diliverydate).ToString("dd MMM yyyy")</td>
                                        <td>
                                           
                                           <a asp-action="viewdetailsorder" asp-route-id="@item.orderid"
                                        class="btn btn-sm btn-outline-dark"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                              <a asp-action="editorderpage" asp-route-id="@item.orderid"
                                               @* class="action-icon view-btn text-decoration-none " *@
                                               class="btn btn-sm btn-outline-dark"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a href="#" class="btn btn-sm btn-outline-dark">
                                                <i class="bi bi-trash"></i>
                                            </a>



                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No orders found in database.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</body>

</html>
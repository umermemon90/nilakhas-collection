@model neworderformki;
@{
    Layout = "~/Views/Shared/_AdminDashbaord.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Stitching Order</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/ASITS/CSS/orderform.css">
</head>
<body>

    <div class="order-container">

        <div class="header-top">
            <div></div>
            <div class="text-center">
                <img src="~/ASITS/IMG(PNG)/weblogo.png" alt="Nilakha's Collection Logo" style="max-height: 50px; width: auto;">
            </div>
            <div class="serial-box">
                <i class="bi bi-hash"></i> Order No: <b>@Model.ordernumber</b>
            </div>
        </div>

        <div class="text-center mb-3">
            <h4 class="fw-bold m-0" style="color: var(--brand-brown); font-size: 17px;">
                Create Stitching Order
            </h4>
        </div>

        <form asp-action="neworderform" asp-controller="AdminDashbaord" method="post" id="orderForm" autocomplete="off">

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Customer Name</label>
                    <input asp-for="customername" type="text" class="form-control" placeholder="Enter full name">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="phonenumber" type="tel" class="form-control" placeholder="03XX-XXXXXXX">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Booking Date</label>
                    <input asp-for="bookingdate" type="date" class="form-control">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Delivery Date</label>
                    <input asp-for="diliverydate" type="date" class="form-control">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Order Status</label>
                    <select asp-for="orderstatus" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="Process">Process</option>
                        <option value="Complete">Complete</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Quantity</label>
                    <input asp-for="quantity" type="number" id="quantity" class="form-control" value="1">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Total (Rs.)</label>
                    <input asp-for="total" type="number" id="total" class="form-control" placeholder="0.00">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Advance (Rs.)</label>
                    <input asp-for="advanced" type="number" id="advance" class="form-control" placeholder="0.00">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Due (Rs.)</label>
                    <input asp-for="duepayment" type="number" id="due" class="form-control" placeholder="0.00" readonly>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="section-title">
                        <i class="bi bi-rulers"></i> Measurement Table
                    </div>
                    <div class="table-responsive table-custom">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Measurement Type</th>
                                    <th style="width: 100px; text-align: center;">Inches</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Length</td><td><input asp-for="lenght" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Chest</td><td><input asp-for="chest" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Waist</td><td><input asp-for="waist" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Daman</td><td><input asp-for="bottom" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Shoulder</td><td><input asp-for="shoulder" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Sleeves</td><td><input asp-for="seelves" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Shalwar / Trouser Length</td><td><input asp-for="shalwar" type="text" class="form-control table-input"></td></tr>
                                <tr><td>Shalwar Bottom</td><td><input asp-for="shalwar_bottom" type="text" class="form-control table-input"></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-md-6 d-flex flex-column justify-content-between">
                    <div>
                        <div class="section-title">
                            <i class="bi bi-bag-check"></i> Stitching Package
                        </div>
                        <div class="d-flex flex-column gap-2 mb-3">
                            <label class="option-card d-flex justify-content-between align-items-center mb-0">
                                <div>
                                    <h6 class="fw-bold mb-0" style="color: var(--brand-brown); font-size: 13px;">Fabric with Silai</h6>
                                    <small class="text-muted" style="font-size: 11px;">Rs. 3300 only</small>
                                </div>
                                <input asp-for="stitchingpackage" class="form-check-input" type="radio" value="Fabric with Silai">
                            </label>

                            <label class="option-card d-flex justify-content-between align-items-center mb-0">
                                <div>
                                    <h6 class="fw-bold mb-0" style="color: var(--brand-brown); font-size: 13px;">Only Stitched</h6>
                                    <small class="text-muted" style="font-size: 11px;">Rs. 1800 only</small>
                                </div>
                                <input asp-for="stitchingpackage" class="form-check-input" type="radio" value="Only Stitched">
                            </label>
                        </div>
                    </div>

                    <div>
                        <div class="section-title">
                            <i class="bi bi-pencil-square"></i> Special Instructions
                        </div>
                        <textarea asp-for="instruction" class="form-control" rows="3" placeholder="Neck styles, pocket designs, or other instructions..." style="resize: none;"></textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-3 pt-2 border-top">
                <button type="reset" class="btn-clear">Clear Form</button>
                <button type="button" class="btn-brand" onclick="showConfirmModal()">
                    Create Order
                </button>
            </div>
        </form>
    </div>

    <!-- CREATE ORDER CONFIRMATION MODAL -->
    <div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header" style="background: var(--brand-brown); color: white;">
                    <h5 class="modal-title">
                        <i class="bi bi-check-circle"></i> Create Order Confirmation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div style="font-size: 50px; color: #3D2511;">
                        <i class="bi bi-question-circle"></i>
                    </div>
                    <h5 class="fw-bold mt-3">
                        Are you sure you want to create this order?
                    </h5>
                    <p class="text-muted mb-0">
                        This order will be saved to the database.
                    </p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn px-4" style="background: var(--brand-brown); color: white;" onclick="submitOrder()">
                        <i class="bi bi-check-lg"></i> Yes, Create
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function showConfirmModal() {
                const form = document.getElementById('orderForm');
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }
                const modalElement = document.getElementById('confirmOrderModal');
                const confirmModal = new bootstrap.Modal(modalElement);
                confirmModal.show();
            }

            function submitOrder() {
                const form = document.getElementById('orderForm');
                form.submit();
            }

            const totalInput = document.getElementById('total');
            const advanceInput = document.getElementById('advance');
            const dueInput = document.getElementById('due');

            function calculateDue() {
                const total = parseFloat(totalInput.value) || 0;
                const advance = parseFloat(advanceInput.value) || 0;
                const due = total - advance;
                dueInput.value = due >= 0 ? due : 0;
            }

            totalInput.addEventListener('input', calculateDue);
            advanceInput.addEventListener('input', calculateDue);
    </script>
</body>
</html>
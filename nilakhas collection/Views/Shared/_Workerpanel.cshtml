<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nilakha's Fashion - Sidebar</title>
    <link rel="stylesheet" href="~/ASITS/CSS/admindashbaord.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

   
       
</head>

<body>

    <!-- Mobile Top Header with Toggle Button -->
    <div class="mobile-header d-lg-none">
        <div class="d-flex align-items-center gap-2">
            <button class="mobile-toggle-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas">
                <i class="bi bi-list"></i>
            </button>
            <span class="fw-bold" style="color: var(--brand-brown);">Nilakha's Fashion</span>
        </div>
        <img src="~/ASITS/IMG(PNG)/weblogo.png" alt="Logo" style="max-height: 35px; width: auto;">
    </div>

    <!-- Sidebar Container -->
    <div class="sidebar-container offcanvas-lg offcanvas-start" tabindex="-1" id="sidebarOffcanvas" data-bs-backdrop="false">
        <div class="w-100">
            <!-- Mobile Close Button inside drawer -->
            <div class="d-flex justify-content-between align-items-center d-lg-none mb-3">
                <span class="fw-bold text-muted small">Menu</span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarOffcanvas" aria-label="Close"></button>
            </div>

            <div class="logo-area">
                <div class="d-flex justify-content-center align-items-center brand-section">
                    <img src="~/ASITS/IMG(PNG)/weblogo.png" alt="Nilakha's Collection Logo"
                         class="img-fluid brand-logo" style="max-height: 7rem; height: auto; width: auto;">
                </div>
            </div>

            <div class="nav-menu">
                <a asp-action="mainpagedashbaord" asp-controller="AdminDashbaord" class="nav-menu-item active">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-action="viewallorderspage" asp-controller="AdminDashbaord" class="nav-menu-item">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>All Orders</span>
                </a>

                <a asp-action="workerscardssignup" asp-controller="Workers" class="nav-menu-item">
                    <i class="bi bi-person-workspace"></i>
                    <span>Workers</span>
                </a>

                <a asp-action="workersignuppage" asp-controller="Workers" class="nav-menu-item">
                    <i class="bi bi-person-plus"></i>
                    <span>Add Worker</span>
                </a>

                <a href="#" class="nav-menu-item">
                    <i class="bi bi-credit-card"></i>
                    <span>Payments</span>
                </a>

                <a href="#" class="nav-menu-item">
                    <i class="bi bi-box-seam"></i>
                    <span>Inventory</span>
                </a>

                <a href="#" class="nav-menu-item">
                    <i class="bi bi-person-plus"></i>
                    <span>Add Admin</span>
                </a>
            </div>
        </div>

        <div class="logout-wrapper w-100">
            <button class="logout-btn">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    



            @RenderBody()
       
    <!-- =========================
     FOOTER
========================= -->

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

</body>
</html>

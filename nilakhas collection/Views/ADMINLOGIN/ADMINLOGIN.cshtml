@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model adminlogin
@{
    ViewData["Title"] = "Admin Login";
    Layout = "~/Views/Shared/_Admin.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" >
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/ASITS/CSS/admin-login.css">
</head>

<body>

    <div class="login-page">

        <div class="login-container">

            <!-- =========================
                 LEFT SIDE
            ========================== -->

            <div class="login-left">

                <div class="left-content">

                    <div class="admin-logo">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>

                    <h1>ADMIN PANEL</h1>

                    <div class="gold-line">
                        <span></span>
                        <i class="fa-solid fa-circle"></i>
                        <span></span>
                    </div>

                    <h2>Welcome Back!</h2>

                    <p>
                        Please login to your account<br>
                        to continue.
                    </p>

                </div>


                <!-- Bottom Illustration -->
                <div class="left-decoration">

                    <div class="desk">
                        <div class="laptop">
                            <div class="apple">
                                <i class="fa-brands fa-apple"></i>
                            </div>
                        </div>

                        <div class="laptop-base"></div>
                    </div>

                    <div class="plant">
                        <i class="fa-solid fa-seedling"></i>
                    </div>

                    <div class="chair"></div>

                </div>

            </div>


            <!-- =========================
                 RIGHT SIDE
            ========================== -->

            <div class="login-right">

                <div class="login-form-container">

                    <!-- Lock Icon -->
                    <div class="lock-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <h2>Admin Login</h2>

                    <p class="login-subtitle">
                        Enter your credentials to access the admin panel
                    </p>


                    <!-- Decorative Line -->
                    <div class="separator">
                        <span></span>
                        <i class="fa-solid fa-circle"></i>
                        <span></span>
                    </div>


                    <!-- Login Form -->
                    <form asp-controller="ADMINLOGIN" asp-action="ADMINLOGIN" method="post" autocomplete="off">

                        <!-- Error Message Display -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger" style="color: red; margin-bottom: 15px;">
                                @ViewBag.Error
                            </div>
                        }

                        <!-- Username -->
                        <div class="input-group">
                            <label for="username">Username</label>
                            <span asp-validation-for="username" class="text-danger"></span>

                            <div class="input-wrapper">
                                <i class="fa-regular fa-user"></i>
                                <!-- name attribute hata diya hai, sirf asp-for rakha hai -->
                                <input type="text"
                                       id="username"
                                       placeholder="Enter your username"
                                       @* autocomplete="username" *@
                                       asp-for="username">
                            </div>
                        </div>


                        <!-- Password -->
                        <div class="input-group">
                            <label for="password">Password</label>
                            <span asp-validation-for="password" class="text-danger"></span>

                            <div class="input-wrapper">
                                <i class="fa-solid fa-lock"></i>
                              
                                <input type="password"
                                       id="password"
                                       placeholder="Enter your password"
                                       @* autocomplete="current-password" *@
                                       asp-for="password">

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword()">
                                    <i class="fa-regular fa-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                        </div>


                        <!-- Options -->
                        <div class="form-options">
                            <label class="remember">
                                <input type="checkbox" asp-for="rememberMe">
                                <span>Remember Me</span>
                            </label>

                            <a href="#">Forgot Password?</a>
                        </div>


                        <!-- Login Button -->
                        <button type="submit" class="login-btn">
                            Login
                        </button>

                        <!-- OR -->
                        <div class="or-separator">
                            <span></span>
                            <p>or</p>
                            <span></span>
                        </div>

                        <!-- Back -->
                        <a asp-action="Index" asp-controller="HOME" class="back-link">
                            <i class="fa-solid fa-arrow-left"></i>
                            Back to Website
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <script>

            function togglePassword() {

                const password =
                    document.getElementById("password");

                const eyeIcon =
                    document.getElementById("eyeIcon");

                if (password.type === "password") {

                    password.type = "text";

                    eyeIcon.classList.remove("fa-eye");
                    eyeIcon.classList.add("fa-eye-slash");

                } else {

                    password.type = "password";

                    eyeIcon.classList.remove("fa-eye-slash");
                    eyeIcon.classList.add("fa-eye");

                }

            }

    </script>

</body>
</html>
